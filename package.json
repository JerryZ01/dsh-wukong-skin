{
  "name": "@daily-vibe/dsh-client-wukong-intensity-skin",
  "version": "0.1.0",
  "description": "滑动变佛 (Slide to Buddha): an opt-in adaptive reasoning slider skin for DeepSeek Harness that turns the model effort dial into a 31-frame journey from stone monkey to Victorious Fighting Buddha.",
  "license": "MIT",
  "author": "JerryZ01",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-skin",
    "deepseek-harness",
    "skin",
    "theme",
    "sun-wukong",
    "monkey-king",
    "reasoning-effort"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JerryZ01/dsh-wukong-skin.git"
  },
  "homepage": "https://github.com/JerryZ01/dsh-wukong-skin#readme",
  "bugs": {
    "url": "https://github.com/JerryZ01/dsh-wukong-skin/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/portrait",
    "cordis.patch.yml",
    "lib/client.js",
    "lib/client.js.map",
    "src/index.js",
    "src/range.js",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build-client.mjs",
    "portraits": "node ./tools/generate-portraits.mjs",
    "preview": "node ./tools/ladder-preview.mjs",
    "skin": "node ./tools/switch-skin.mjs",
    "test": "npm run check && npm run test:unit && npm run test:dom && npm run test:render",
    "check": "node ./tools/check-forward.mjs",
    "test:unit": "node ./tools/test-logic.mjs && node ./tools/test-assets.mjs",
    "test:dom": "node ./tools/test-dom.mjs",
    "test:render": "node ./tools/test-render.mjs",
    "test:compose": "node ./tools/test-compose.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
