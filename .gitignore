# 依赖
node_modules/

# 本地缓存（含 31 帧的中间 PNG）
.cache/

# 生图中转产物
tools/probe-*.svg
tools/probe-*.webp

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# 日志与临时文件
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak

# 环境变量与密钥（生图 key 只放环境变量，永不入库）
.env
.env.*
!.env.example
*.pem

# 台词音频：由使用者自行准备，仓库不收录
#
# 素材多为 1986 版电视剧的录音，著作权归央视、表演者权归李世宏/李扬。
# 本地随便用，但不要连仓库一起公开分发。
assets/voice/*.wav
assets/voice/*.mp3
assets/voice/*.m4a
assets/voice/*.ogg
assets/voice/*.flac
assets/voice/*.aac
assets/voice/*.wma
!assets/voice/.gitkeep
